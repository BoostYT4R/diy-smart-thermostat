# Copy this file to secrets.yaml (next to the board YAMLs) and fill in your own values.
# secrets.yaml is listed in .gitignore so it never gets uploaded.
wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"
fallback_password: "a-password-for-the-setup-hotspot"
api_key: "generate one at https://esphome.io/components/api.html (32-byte base64)"
ota_password: "any-password-you-like"
